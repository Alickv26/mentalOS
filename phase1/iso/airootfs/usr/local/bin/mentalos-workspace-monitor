#!/usr/bin/env bash
# mentalOS workspace monitor — placeholder implementation.
#
# Watches ~/workspaces for create/modify/delete events and logs them.
# Eventually this will be replaced by a Rust binary that forwards events
# to mentalOS via the backend channel so the UI can refresh in real time.
#
# For now, this just uses inotifywait (from inotify-tools) if available,
# and falls back to a polling loop if inotifywait is not installed.

set -euo pipefail

WORKSPACE_DIR="${WORKSPACE_DIR:-${HOME}/workspaces}"
STATE_DIR="${WORKSPACE_DIR}/.mentalOS"
LOG_FILE="${STATE_DIR}/workspace-monitor.log"

mkdir -p "${STATE_DIR}"

log() {
    printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*" | tee -a "${LOG_FILE}"
}

log "mentalOS workspace monitor starting"
log "Watching: ${WORKSPACE_DIR}"

if ! command -v inotifywait >/dev/null 2>&1; then
    log "inotifywait not found (install inotify-tools for event-driven mode)"
    log "Falling back to 60s polling loop"

    while true; do
        # Snapshot all files under workspaces with their mtimes.
        snapshot="$(find "${WORKSPACE_DIR}" -type f -printf '%T@ %p\n' 2>/dev/null | sort)"
        if [[ "${snapshot}" != "${last_snapshot:-}" ]]; then
            log "Workspace contents changed ($(echo "${snapshot}" | wc -l) files)"
            last_snapshot="${snapshot}"
        fi
        sleep 60
    done
    exit 0
fi

# Event-driven mode using inotifywait
# -m   monitor (don't exit after first event)
# -r   recursive
# -e   events to watch
# --format custom format string
log "Using inotifywait event-driven mode"

inotifywait -m -r \
    -e create -e modify -e delete -e move \
    --format '%w%f %e %T' \
    --timefmt '%Y-%m-%dT%H:%M:%S' \
    "${WORKSPACE_DIR}" 2>>"${LOG_FILE}" |
    while IFS= read -r line; do
        log "inotify event: ${line}"
    done
